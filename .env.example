POSTGRES_DB=lavanderia
POSTGRES_USER=lavanderia
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_PORT=15432
DEV_HOST_IP=192.168.1.13
PGPOOL_MAX=10

# US-001.01: generar una clave aleatoria de al menos 32 bytes; nunca versionar secretos reales.
REGISTRATION_HMAC_KEY=
RESEND_API_KEY=
# Dirección del marketplace en dominio propio verificado en Resend.
REGISTRATION_FROM_EMAIL=
REGISTRATION_EMAIL_HOURLY_LIMIT=5
REGISTRATION_IP_HOURLY_LIMIT=30
REGISTRATION_GLOBAL_HOURLY_LIMIT=100
REGISTRATION_GLOBAL_DAILY_LIMIT=100
REGISTRATION_REQUEST_IP_HOURLY_LIMIT=120
# Solo para pruebas web; en producción usar orígenes HTTPS explícitos, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Opcional: API para navegador PC al usar Compose Android; dirección pública, sin secretos.
# EXPO_PUBLIC_WEB_API_URL=http://localhost:3000

# OAuth: IDs públicos; no colocar secretos ni claves privadas en EXPO_PUBLIC_*.
GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APP_ID=com.lavanderia.marketplace.dev
# Fixtures locales: desactivados por defecto; contraseña privada, nunca versionada.
DEV_SEED_ENABLED=false
DEV_SEED_PASSWORD=
